# Everything is optional. The app runs fully without any of these.

# OpenRouteService key (free): enables routing that actively avoids high-risk hexes.
# Without it the app uses the free FOSSGIS OSRM server and only ranks routes.
VITE_ORS_KEY=

# Supabase project (free tier): enables shared reports, Telegram SOS alerts and the sealed trail.
# Without it, reports and contacts are stored only in this browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Default map centre when location permission is denied (Thane station).
VITE_DEFAULT_LAT=19.1861
VITE_DEFAULT_LNG=72.9756
